FROM oven/bun:1.4.4-alpine AS builder

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .

ARG DATABASE_URL=postgresql://cospace:cospace@localhost:5432/cospace
ARG JWT_ACCESS_SECRET=build-only-access-secret-0000000000000000
ARG JWT_REFRESH_SECRET=build-only-refresh-secret-000000000000000
ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ARG NEXT_PUBLIC_VENUE_TIMEZONE=America/Bogota
ARG NEXT_PUBLIC_VENUE_CURRENCY=COP

ENV DATABASE_URL=$DATABASE_URL
ENV JWT_ACCESS_SECRET=$JWT_ACCESS_SECRET
ENV JWT_REFRESH_SECRET=$JWT_REFRESH_SECRET
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_VENUE_TIMEZONE=$NEXT_PUBLIC_VENUE_TIMEZONE
ENV NEXT_PUBLIC_VENUE_CURRENCY=$NEXT_PUBLIC_VENUE_CURRENCY

RUN bun run build

FROM builder AS runner

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

EXPOSE 3000

CMD ["bun", "run", "start", "--", "-H", "0.0.0.0", "-p", "3000"]
