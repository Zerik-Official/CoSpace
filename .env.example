# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string. Locally you can use the docker-compose service
# (postgres://cospace:cospace@localhost:5433/cospace). In production this is the
# Supabase connection string, found in Project settings > Database > Connection
# string > URI (use the "Session pooler" URI when deploying to Vercel).
DATABASE_URL=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Secret used to sign the short-lived access token (HS256).
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=

# Secret reserved for refresh-token derivation material. Refresh tokens are
# opaque random values stored hashed (SHA-256) in PostgreSQL, never as JWT.
# Generate with: openssl rand -hex 32
JWT_REFRESH_SECRET=

# Cloudflare Turnstile protects the login and registration forms.
# Create a widget at https://dash.cloudflare.com > Turnstile and copy both keys.
# Use the official test keys locally until the production widget is configured:
# Site key: 1x00000000000000000000AA
# Secret key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Access token lifetime. Accepts s, m, h or d suffixes (e.g. 900s, 15m, 1h).
ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh token lifetime. Accepts s, m, h or d suffixes (e.g. 7d, 24h).
REFRESH_TOKEN_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public base URL, used for absolute links and cookie helpers.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# IANA time zone the venue operates in. Opening hours (07:00-21:00), the booking
# window and the cancellation notice are all evaluated in this zone. Exposed to
# the browser on purpose so dates render identically on the server and client.
NEXT_PUBLIC_VENUE_TIMEZONE=America/Bogota

# ISO-4217 currency space prices are published in.
NEXT_PUBLIC_VENUE_CURRENCY=COP

# ---------------------------------------------------------------------------
# Seed (administrator account created by `bun run db:seed`)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@cospace.dev
SEED_ADMIN_PASSWORD=Admin1234!
SEED_ADMIN_NAME=Ada Restrepo
